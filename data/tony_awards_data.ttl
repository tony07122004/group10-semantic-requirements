@prefix ex: <https://w3id.org/tony-awards/resource#> .
@prefix myOnt: <https://w3id.org/tony-awards/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:TonyAwards
    a myOnt:TonyAward ;
    skos:prefLabel "Tony Awards"@en .

ex:Helen_Mirren
    a foaf:Person ;
    foaf:name "Helen Mirren" .

ex:Michael_Cerveris
    a foaf:Person ;
    foaf:name "Michael Cerveris" .

ex:The_Audience
    a schema:CreativeWork ;
    myOnt:workTitle "The Audience" .

ex:Fun_Home
    a schema:CreativeWork ;
    myOnt:workTitle "Fun Home" .

ex:Feminine
    a myOnt:GenderCategory , myOnt:FeminineCategory ;
    skos:prefLabel "femenina"@es .

ex:Masculine
    a myOnt:GenderCategory , myOnt:MasculineCategory ;
    skos:prefLabel "masculina"@es .

ex:Best_Actress_Play
    a myOnt:AwardCategory ;
    myOnt:categoryLabel "Tony Award Best Actress in a Play" ;
    skos:prefLabel "Tony Award Best Actress in a Play"@en ;
    myOnt:belongsToAward ex:TonyAwards .

ex:Best_Actor_Musical
    a myOnt:AwardCategory ;
    myOnt:categoryLabel "Tony Award Best Actor in a Musical" ;
    skos:prefLabel "Tony Award Best Actor in a Musical"@en ;
    myOnt:belongsToAward ex:TonyAwards .

ex:Winning_2015_Helen_Mirren
    a myOnt:AwardWinning ;
    myOnt:winner ex:Helen_Mirren ;
    myOnt:awardedForWork ex:The_Audience ;
    myOnt:hasAwardCategory ex:Best_Actress_Play ;
    myOnt:hasGenderCategory ex:Feminine ;
    myOnt:awardYear 2015 ;
    myOnt:genderCategory "femenina" .

ex:Winning_2015_Michael_Cerveris
    a myOnt:AwardWinning ;
    myOnt:winner ex:Michael_Cerveris ;
    myOnt:awardedForWork ex:Fun_Home ;
    myOnt:hasAwardCategory ex:Best_Actor_Musical ;
    myOnt:hasGenderCategory ex:Masculine ;
    myOnt:awardYear 2015 ;
    myOnt:genderCategory "masculina" .
