@prefix ex: <https://w3id.org/tony-awards/resource#> .
@prefix myOnt: <https://w3id.org/tony-awards/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Knowledge Graph generated from data/dataset_combinado_.csv
# Complete valid records represented: 134
# Rows with missing required values were not included because the SHACL shapes require winner, work, category, year and gender values.

ex:TonyAwards
    a myOnt:TonyAward ;
    skos:prefLabel "Tony Awards"@en .

# Gender categories
ex:Feminine
    a myOnt:GenderCategory , myOnt:FeminineCategory ;
    skos:prefLabel "femenina"@es .

ex:Masculine
    a myOnt:GenderCategory , myOnt:MasculineCategory ;
    skos:prefLabel "masculina"@es .

# Award categories
ex:Best_Actor_in_a_Musical
    a myOnt:AwardCategory , myOnt:MusicalAward , myOnt:BestActorAward ;
    myOnt:categoryLabel "Tony Award Best Actor in a Musical" ;
    skos:prefLabel "Tony Award Best Actor in a Musical"@en ;
    myOnt:categoryType "Musical" ;
    myOnt:belongsToAward ex:TonyAwards .

ex:Best_Actor_in_a_Play
    a myOnt:AwardCategory , myOnt:PlayAward , myOnt:BestActorAward ;
    myOnt:categoryLabel "Tony Award Best Actor in a Play" ;
    skos:prefLabel "Tony Award Best Actor in a Play"@en ;
    myOnt:categoryType "Play" ;
    myOnt:belongsToAward ex:TonyAwards .

ex:Best_Actress_in_a_Musical
    a myOnt:AwardCategory , myOnt:MusicalAward , myOnt:BestActressAward ;
    myOnt:categoryLabel "Tony Award Best Actress in a Musical" ;
    skos:prefLabel "Tony Award Best Actress in a Musical"@en ;
    myOnt:categoryType "Musical" ;
    myOnt:belongsToAward ex:TonyAwards .

ex:Best_Actress_in_a_Play
    a myOnt:AwardCategory , myOnt:PlayAward , myOnt:BestActressAward ;
    myOnt:categoryLabel "Tony Award Best Actress in a Play" ;
    skos:prefLabel "Tony Award Best Actress in a Play"@en ;
    myOnt:categoryType "Play" ;
    myOnt:belongsToAward ex:TonyAwards .

