   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema1="http://schema.org/"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="http://schema.org/CreativeWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Creative work</rdfs:label>
    <rdfs:comment xml:lang="en">A play or musical work for which a person received a Tony Award.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b7"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://schema.org/name"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#FeminineCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/tony#GenderCategory"/>
    <rdfs:label xml:lang="en">Feminine category</rdfs:label>
    <rdfs:comment xml:lang="en">Feminine award category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the winning person. It corresponds to the NOMBRE column in the dataset.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#ActingAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/tony#PerformanceAward"/>
    <rdfs:label xml:lang="en">Acting award</rdfs:label>
    <rdfs:comment xml:lang="en">A Tony Award category related to acting performances.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <rdfs:comment xml:lang="en">A person who won a Tony Award in the dataset.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b6"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#BestActorInAMusical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/ontology/tony#MusicalAward"/>
    <rdf:type rdf:resource="http://example.org/ontology/tony#BestActorAward"/>
    <skos:prefLabel xml:lang="en">Tony Award Best Actor in a Musical</skos:prefLabel>
    <myOnt:categoryType>Musical</myOnt:categoryType>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#BestActressInAPlay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/ontology/tony#PlayAward"/>
    <rdf:type rdf:resource="http://example.org/ontology/tony#BestActressAward"/>
    <skos:prefLabel xml:lang="en">Tony Award Best Actress in a Play</skos:prefLabel>
    <myOnt:categoryType>Play</myOnt:categoryType>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Tony Awards Winners Ontology</dcterms:title>
    <dcterms:creator xml:lang="en">Group 10</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology for representing Tony Award winners from 1982 to 2015, including winners, works, award categories, years and gender categories.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <vann:preferredNamespacePrefix>myOnt</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://example.org/ontology/tony#</vann:preferredNamespaceUri>
    <rdfs:label xml:lang="en">Tony Awards Winners Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">This ontology models Tony Award winning records using an n-ary relation represented by myOnt:AwardWinning.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#winner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardWinning"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdfs:label xml:lang="en">winner</rdfs:label>
    <rdfs:comment xml:lang="en">Links an award-winning record to the person who received the award.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#AwardWinning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Award winning record</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete record representing that a person won a Tony Award in a given year for a specific work and category.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b1"/>
    <rdfs:subClassOf rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b2"/>
    <rdfs:subClassOf rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b3"/>
    <rdfs:subClassOf rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b4"/>
    <rdfs:subClassOf rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/ontology/tony#awardedForWork"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="http://schema.org/CreativeWork"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#MusicalAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/tony#ActingAward"/>
    <rdfs:label xml:lang="en">Musical award</rdfs:label>
    <rdfs:comment xml:lang="en">A Tony Award acting category associated with musicals.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/name"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#Winning_2015_Helen_Mirren">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/ontology/tony#AwardWinning"/>
    <myOnt:recordIdentifier>Winning_2015_Helen_Mirren</myOnt:recordIdentifier>
    <myOnt:winner rdf:resource="http://example.org/ontology/tony#HelenMirren"/>
    <myOnt:awardedForWork rdf:resource="http://example.org/ontology/tony#TheAudience"/>
    <myOnt:hasAwardCategory rdf:resource="http://example.org/ontology/tony#BestActressInAPlay"/>
    <myOnt:hasGenderCategory rdf:resource="http://example.org/ontology/tony#Feminine"/>
    <myOnt:awardYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2015</myOnt:awardYear>
    <myOnt:genderCategory>femenina</myOnt:genderCategory>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#AwardCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/tony#TonyAward"/>
    <rdfs:subClassOf rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b8"/>
    <rdfs:label xml:lang="en">Award category</rdfs:label>
    <rdfs:comment xml:lang="en">A category of the Tony Awards, such as Best Actor in a Play or Best Actress in a Musical.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#belongsToAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardCategory"/>
    <rdfs:range rdf:resource="http://example.org/ontology/tony#TonyAward"/>
    <rdfs:label xml:lang="en">belongs to award</rdfs:label>
    <rdfs:comment xml:lang="en">Links an award category to the general Tony Award.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#BestActressAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/tony#ActingAward"/>
    <rdfs:label xml:lang="en">Best actress award</rdfs:label>
    <rdfs:comment xml:lang="en">A Tony Award category for female acting performances.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#hasAwardCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardWinning"/>
    <rdfs:range rdf:resource="http://example.org/ontology/tony#AwardCategory"/>
    <rdfs:label xml:lang="en">has award category</rdfs:label>
    <rdfs:comment xml:lang="en">Links an award-winning record to its award category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#PerformanceAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/tony#AwardCategory"/>
    <rdfs:label xml:lang="en">Performance award</rdfs:label>
    <rdfs:comment xml:lang="en">A Tony Award category related to performance.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#BestActressInAMusical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/ontology/tony#MusicalAward"/>
    <rdf:type rdf:resource="http://example.org/ontology/tony#BestActressAward"/>
    <skos:prefLabel xml:lang="en">Tony Award Best Actress in a Musical</skos:prefLabel>
    <myOnt:categoryType>Musical</myOnt:categoryType>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#HelenMirren">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
