>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#BestActressInAPlay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/tony-awards/ontology#AwardCategory"/>
    <rdf:type rdf:resource="https://w3id.org/tony-awards/ontology#PlayAward"/>
    <rdf:type rdf:resource="https://w3id.org/tony-awards/ontology#BestActressAward"/>
    <skos:prefLabel xml:lang="en">Tony Award Best Actress in a Play</skos:prefLabel>
    <myOnt:categoryLabel>Tony Award Best Actress in a Play</myOnt:categoryLabel>
    <myOnt:categoryType>Play</myOnt:categoryType>
    <myOnt:belongsToAward rdf:resource="https://w3id.org/tony-awards/ontology#TonyAwards"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Tony Awards Winners Ontology</dcterms:title>
    <dcterms:creator xml:lang="en">Group 10</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology for representing Tony Award winners from 1982 to 2015, including winners, works, award categories, years and gender categories.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <vann:preferredNamespacePrefix>myOnt</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/tony-awards/ontology#</vann:preferredNamespaceUri>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <rdfs:label xml:lang="en">Tony Awards Winners Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">This ontology models Tony Award winning records using an n-ary relation represented by myOnt:AwardWinning.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#DatasetRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dataset record</rdfs:label>
    <rdfs:comment xml:lang="en">A record extracted from the original Tony Awards dataset.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#FeminineCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tony-awards/ontology#GenderCategory"/>
    <rdfs:label xml:lang="en">Feminine category</rdfs:label>
    <rdfs:comment xml:lang="en">Feminine award category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://schema.org/name"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the awarded work. It corresponds to the OBRA column in the dataset.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tony-awards/ontology#awardedForWork"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="http://schema.org/CreativeWork"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#TonyAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tony Award</rdfs:label>
    <rdfs:comment xml:lang="en">General class representing Tony Awards.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#BestActressInAMusical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/tony-awards/ontology#AwardCategory"/>
    <rdf:type rdf:resource="https://w3id.org/tony-awards/ontology#MusicalAward"/>
    <rdf:type rdf:resource="https://w3id.org/tony-awards/ontology#BestActressAward"/>
    <skos:prefLabel xml:lang="en">Tony Award Best Actress in a Musical</skos:prefLabel>
    <myOnt:categoryLabel>Tony Award Best Actress in a Musical</myOnt:categoryLabel>
    <myOnt:categoryType>Musical</myOnt:categoryType>
    <myOnt:belongsToAward rdf:resource="https://w3id.org/tony-awards/ontology#TonyAwards"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#ActingAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tony-awards/ontology#PerformanceAward"/>
    <rdfs:label xml:lang="en">Acting award</rdfs:label>
    <rdfs:comment xml:lang="en">A Tony Award category related to acting performances.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#awardedForWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tony-awards/ontology#AwardWinning"/>
    <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
    <rdfs:label xml:lang="en">awarded for work</rdfs:label>
    <rdfs:comment xml:lang="en">Links an award-winning record to the work for which the award was received.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tony-awards/ontology#awardYear"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tony-awards/ontology#hasAwardCategory"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/tony-awards/ontology#AwardCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">preferred label</rdfs:label>
    <rdfs:comment xml:lang="en">Preferred lexical label for an award category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#TonyAwards">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/tony-awards/ontology#TonyAward"/>
    <rdfs:label xml:lang="en">Tony Awards</rdfs:label>
    <rdfs:comment xml:lang="en">The general Tony Awards entity to which all award categories belong.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#BestActorInAMusical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
