  <rdf:Description rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tony-awards/ontology#hasGenderCategory"/>
