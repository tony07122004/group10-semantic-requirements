    <rdfs:range rdf:resource="https://w3id.org/tony-awards/ontology#TonyAward"/>
    <rdfs:label xml:lang="en">belongs to award</rdfs:label>
    <rdfs:comment xml:lang="en">Links an award category to the general Tony Award.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/tony-awards/ontology#genderCategory"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person">
