  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#MusicalAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tony-awards/ontology#ActingAward"/>
    <rdfs:label xml:lang="en">Musical award</rdfs:label>
    <rdfs:comment xml:lang="en">A Tony Award acting category associated with musicals.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#genderCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tony-awards/ontology#AwardWinning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">gender category literal</rdfs:label>
    <rdfs:comment xml:lang="en">Literal value used in the dataset for masculine or feminine category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#awardYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tony-awards/ontology#AwardWinning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">award year</rdfs:label>
    <rdfs:comment xml:lang="en">Year in which the award was received. It corresponds to the AÑO column in the dataset.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#categoryLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tony-awards/ontology#AwardCategory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">category label</rdfs:label>
    <rdfs:comment xml:lang="en">Literal label used to identify an award category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#BestActressAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tony-awards/ontology#ActingAward"/>
    <rdfs:label xml:lang="en">Best actress award</rdfs:label>
