  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#TonyAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tony Award</rdfs:label>
    <rdfs:comment xml:lang="en">General class representing Tony Awards.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#awardedForWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardWinning"/>
    <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
    <rdfs:label xml:lang="en">awarded for work</rdfs:label>
    <rdfs:comment xml:lang="en">Links an award-winning record to the work for which the award was received.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#MasculineCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/tony#GenderCategory"/>
    <rdfs:label xml:lang="en">Masculine category</rdfs:label>
    <rdfs:comment xml:lang="en">Masculine award category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#genderCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardWinning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">gender category literal</rdfs:label>
    <rdfs:comment xml:lang="en">Literal value used in the dataset for masculine or feminine category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the awarded work. It corresponds to the OBRA column in the dataset.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">preferred label</rdfs:label>
    <rdfs:comment xml:lang="en">Preferred lexical label for an award category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/ontology/tony#hasAwardCategory"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="http://example.org/ontology/tony#AwardCategory"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9b289200d59a4c2aaa84720ddae1faf5b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/ontology/tony#winner"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#awardYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardWinning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">award year</rdfs:label>
    <rdfs:comment xml:lang="en">Year in which the award was received. It corresponds to the AÑO column in the dataset.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#BestActorAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/tony#ActingAward"/>
    <rdfs:label xml:lang="en">Best actor award</rdfs:label>
    <rdfs:comment xml:lang="en">A Tony Award category for male acting performances.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#recordIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardWinning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">record identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier for a dataset record.</rdfs:comment>
  </rdf:Description>
