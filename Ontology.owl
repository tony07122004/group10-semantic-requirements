    <rdf:type rdf:resource="http://example.org/ontology/tony#BestActorAward"/>
    <skos:prefLabel xml:lang="en">Tony Award Best Actor in a Play</skos:prefLabel>
    <myOnt:categoryType>Play</myOnt:categoryType>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#categoryType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardCategory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">category type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of award category, for example Play or Musical.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/tony#hasGenderCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/tony#AwardWinning"/>
