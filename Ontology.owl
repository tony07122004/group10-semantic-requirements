  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#hasGenderCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/tony-awards/ontology#AwardWinning"/>
    <rdfs:range rdf:resource="https://w3id.org/tony-awards/ontology#GenderCategory"/>
    <rdfs:label xml:lang="en">has gender category</rdfs:label>
    <rdfs:comment xml:lang="en">Links an award-winning record to the masculine or feminine category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#AwardWinning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tony-awards/ontology#DatasetRecord"/>
    <rdfs:subClassOf rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab1"/>
    <rdfs:subClassOf rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab2"/>
    <rdfs:subClassOf rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab3"/>
    <rdfs:subClassOf rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab4"/>
    <rdfs:subClassOf rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab5"/>
    <rdfs:subClassOf rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab6"/>
    <rdfs:label xml:lang="en">Award winning record</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete record representing that a person won a Tony Award in a given year for a specific work and category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#AwardCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tony-awards/ontology#TonyAward"/>
    <rdfs:subClassOf rdf:nodeID="na0a424b33ec24e28b1bd79b5fe20241ab9"/>
    <rdfs:label xml:lang="en">Award category</rdfs:label>
    <rdfs:comment xml:lang="en">A category of the Tony Awards, such as Best Actor in a Play or Best Actress in a Musical.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tony-awards/ontology#MasculineCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tony-awards/ontology#GenderCategory"/>
    <rdfs:label xml:lang="en">Masculine category</rdfs:label>
