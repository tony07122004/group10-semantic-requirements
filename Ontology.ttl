@prefix : <https://w3id.org/tony-awards/ontology#> .
@prefix myOnt: <https://w3id.org/tony-awards/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

<https://w3id.org/tony-awards/ontology>
    a owl:Ontology ;
    dcterms:title "Tony Awards Winners Ontology"@en ;
    dcterms:creator "Group 10"@en ;
    dcterms:description "Ontology for representing Tony Award winners from 1982 to 2015, including winners, works, award categories, years and gender categories."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "myOnt" ;
    vann:preferredNamespaceUri "https://w3id.org/tony-awards/ontology#" ;
    owl:versionInfo "1.0.0" ;
    rdfs:label "Tony Awards Winners Ontology"@en ;
    rdfs:comment "This ontology models Tony Award winning records using an n-ary relation represented by myOnt:AwardWinning."@en .


# Reused external classes


foaf:Person
    a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A person who won a Tony Award in the dataset."@en .

schema:CreativeWork
    a owl:Class ;
    rdfs:label "Creative work"@en ;
    rdfs:comment "A play or musical work for which a person received a Tony Award."@en .


# Classes defined in this ontology


myOnt:DatasetRecord
    a owl:Class ;
    rdfs:label "Dataset record"@en ;
    rdfs:comment "A record extracted from the original Tony Awards dataset."@en .

myOnt:TonyAward
    a owl:Class ;
    rdfs:label "Tony Award"@en ;
    rdfs:comment "General class representing Tony Awards."@en .

myOnt:AwardWinning
    a owl:Class ;
    rdfs:subClassOf myOnt:DatasetRecord ;
    rdfs:label "Award winning record"@en ;
    rdfs:comment "A concrete record representing that a person won a Tony Award in a given year for a specific work and category."@en .

myOnt:AwardCategory
    a owl:Class ;
    rdfs:subClassOf myOnt:TonyAward ;
    rdfs:label "Award category"@en ;
    rdfs:comment "A category of the Tony Awards, such as Best Actor in a Play or Best Actress in a Musical."@en .

myOnt:PerformanceAward
    a owl:Class ;
    rdfs:subClassOf myOnt:AwardCategory ;
    rdfs:label "Performance award"@en ;
    rdfs:comment "A Tony Award category related to performance."@en .

myOnt:ActingAward
    a owl:Class ;
    rdfs:subClassOf myOnt:PerformanceAward ;
    rdfs:label "Acting award"@en ;
    rdfs:comment "A Tony Award category related to acting performances."@en .

myOnt:PlayAward
    a owl:Class ;
    rdfs:subClassOf myOnt:ActingAward ;
    rdfs:label "Play award"@en ;
    rdfs:comment "A Tony Award acting category associated with plays."@en .

myOnt:MusicalAward
    a owl:Class ;
    rdfs:subClassOf myOnt:ActingAward ;
    rdfs:label "Musical award"@en ;
    rdfs:comment "A Tony Award acting category associated with musicals."@en .

myOnt:BestActorAward
    a owl:Class ;
    rdfs:subClassOf myOnt:ActingAward ;
    rdfs:label "Best actor award"@en ;
    rdfs:comment "A Tony Award category for male acting performances."@en .

myOnt:BestActressAward
    a owl:Class ;
    rdfs:subClassOf myOnt:ActingAward ;
    rdfs:label "Best actress award"@en ;
    rdfs:comment "A Tony Award category for female acting performances."@en .

myOnt:GenderCategory
    a owl:Class ;
    rdfs:label "Gender category"@en ;
    rdfs:comment "Category used in the dataset to distinguish masculine and feminine award categories."@en .

myOnt:MasculineCategory
    a owl:Class ;
    rdfs:subClassOf myOnt:GenderCategory ;
    rdfs:label "Masculine category"@en ;
    rdfs:comment "Masculine award category."@en .

myOnt:FeminineCategory
    a owl:Class ;
    rdfs:subClassOf myOnt:GenderCategory ;
    rdfs:label "Feminine category"@en ;
    rdfs:comment "Feminine award category."@en .



# Disjointness axioms

[] a owl:AllDisjointClasses ;
    owl:members (
        foaf:Person
        schema:CreativeWork
        myOnt:AwardWinning
        myOnt:AwardCategory
        myOnt:GenderCategory
    ) .

myOnt:MasculineCategory owl:disjointWith myOnt:FeminineCategory .

myOnt:PlayAward owl:disjointWith myOnt:MusicalAward .

myOnt:BestActorAward owl:disjointWith myOnt:BestActressAward .

# Object properties

myOnt:winner
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain myOnt:AwardWinning ;
    rdfs:range foaf:Person ;
    rdfs:label "winner"@en ;
    rdfs:comment "Links an award-winning record to the person who received the award."@en .

myOnt:awardedForWork
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain myOnt:AwardWinning ;
    rdfs:range schema:CreativeWork ;
    rdfs:label "awarded for work"@en ;
    rdfs:comment "Links an award-winning record to the work for which the award was received."@en .

myOnt:hasAwardCategory
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain myOnt:AwardWinning ;
    rdfs:range myOnt:AwardCategory ;
    rdfs:label "has award category"@en ;
    rdfs:comment "Links an award-winning record to its award category."@en .

myOnt:hasGenderCategory
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain myOnt:AwardWinning ;
    rdfs:range myOnt:GenderCategory ;
    rdfs:label "has gender category"@en ;
    rdfs:comment "Links an award-winning record to the masculine or feminine category."@en .

myOnt:belongsToAward
    a owl:ObjectProperty ;
    rdfs:domain myOnt:AwardCategory ;
    rdfs:range myOnt:TonyAward ;
    rdfs:label "belongs to award"@en ;
    rdfs:comment "Links an award category to the general Tony Award."@en .

# Inverse object properties

myOnt:isWinnerOf
    a owl:ObjectProperty ;
    owl:inverseOf myOnt:winner ;
    rdfs:domain foaf:Person ;
    rdfs:range myOnt:AwardWinning ;
    rdfs:label "is winner of"@en ;
    rdfs:comment "Links a person to the award-winning records in which the person is the winner."@en .

myOnt:isWorkAwardedIn
    a owl:ObjectProperty ;
    owl:inverseOf myOnt:awardedForWork ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range myOnt:AwardWinning ;
    rdfs:label "is work awarded in"@en ;
    rdfs:comment "Links a creative work to the award-winning records in which the work was awarded."@en .

myOnt:isAwardCategoryOf
    a owl:ObjectProperty ;
    owl:inverseOf myOnt:hasAwardCategory ;
    rdfs:domain myOnt:AwardCategory ;
    rdfs:range myOnt:AwardWinning ;
    rdfs:label "is award category of"@en ;
    rdfs:comment "Links an award category to the award-winning records that use that category."@en .

myOnt:isGenderCategoryOf
    a owl:ObjectProperty ;
    owl:inverseOf myOnt:hasGenderCategory ;
    rdfs:domain myOnt:GenderCategory ;
    rdfs:range myOnt:AwardWinning ;
    rdfs:label "is gender category of"@en ;
    rdfs:comment "Links a gender category to the award-winning records that use that gender category."@en .

myOnt:hasCategory
    a owl:ObjectProperty ;
    owl:inverseOf myOnt:belongsToAward ;
    rdfs:domain myOnt:TonyAward ;
    rdfs:range myOnt:AwardCategory ;
    rdfs:label "has category"@en ;
    rdfs:comment "Links the general Tony Award entity to its award categories."@en .

# Datatype properties


myOnt:awardYear
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain myOnt:AwardWinning ;
    rdfs:range xsd:integer ;
    rdfs:label "award year"@en ;
    rdfs:comment "Year in which the award was received. It corresponds to the AÑO column in the dataset."@en .

myOnt:genderCategory
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain myOnt:AwardWinning ;
    rdfs:range xsd:string ;
    rdfs:label "gender category literal"@en ;
    rdfs:comment "Literal value used in the dataset for masculine or feminine category."@en .

myOnt:recordIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain myOnt:AwardWinning ;
    rdfs:range xsd:string ;
    rdfs:label "record identifier"@en ;
    rdfs:comment "Identifier for a dataset record."@en .

myOnt:categoryType
    a owl:DatatypeProperty ;
    rdfs:domain myOnt:AwardCategory ;
    rdfs:range xsd:string ;
    rdfs:label "category type"@en ;
    rdfs:comment "Type of award category, for example Play or Musical."@en .

myOnt:categoryLabel
    a owl:DatatypeProperty ;
    rdfs:domain myOnt:AwardCategory ;
    rdfs:range xsd:string ;
    rdfs:label "category label"@en ;
    rdfs:comment "Literal label used to identify an award category."@en .

foaf:name
    a owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string ;
    rdfs:label "name"@en ;
    rdfs:comment "Name of the winning person. It corresponds to the NOMBRE column in the dataset."@en .

schema:name
    a owl:DatatypeProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range xsd:string ;
    rdfs:label "name"@en ;
    rdfs:comment "Name of the awarded work. It corresponds to the OBRA column in the dataset."@en .


# Annotation properties


skos:prefLabel
    a owl:AnnotationProperty ;
    rdfs:label "preferred label"@en ;
    rdfs:comment "Preferred lexical label for an award category."@en .


# Restrictions


myOnt:AwardWinning
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty myOnt:winner ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass foaf:Person
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty myOnt:awardedForWork ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass schema:CreativeWork
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty myOnt:hasAwardCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass myOnt:AwardCategory
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty myOnt:hasGenderCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass myOnt:GenderCategory
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty myOnt:awardYear ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty myOnt:genderCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string
        ] .

foaf:Person
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty foaf:name ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string
        ] .

schema:CreativeWork
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty schema:name ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string
        ] .

myOnt:AwardCategory
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty myOnt:categoryLabel ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string
        ] .


# Individuals


myOnt:TonyAwards
    a owl:NamedIndividual , myOnt:TonyAward ;
    rdfs:label "Tony Awards"@en ;
    rdfs:comment "The general Tony Awards entity to which all award categories belong."@en .

myOnt:Masculine
    a owl:NamedIndividual , myOnt:MasculineCategory ;
    skos:prefLabel "masculina"@es .

myOnt:Feminine
    a owl:NamedIndividual , myOnt:FeminineCategory ;
    skos:prefLabel "femenina"@es .

myOnt:BestActressInAPlay
    a owl:NamedIndividual , myOnt:AwardCategory , myOnt:PlayAward , myOnt:BestActressAward ;
    skos:prefLabel "Tony Award Best Actress in a Play"@en ;
    myOnt:categoryLabel "Tony Award Best Actress in a Play" ;
    myOnt:categoryType "Play" ;
    myOnt:belongsToAward myOnt:TonyAwards .

myOnt:BestActorInAPlay
    a owl:NamedIndividual , myOnt:AwardCategory , myOnt:PlayAward , myOnt:BestActorAward ;
    skos:prefLabel "Tony Award Best Actor in a Play"@en ;
    myOnt:categoryLabel "Tony Award Best Actor in a Play" ;
    myOnt:categoryType "Play" ;
    myOnt:belongsToAward myOnt:TonyAwards .

myOnt:BestActressInAMusical
    a owl:NamedIndividual , myOnt:AwardCategory , myOnt:MusicalAward , myOnt:BestActressAward ;
    skos:prefLabel "Tony Award Best Actress in a Musical"@en ;
    myOnt:categoryLabel "Tony Award Best Actress in a Musical" ;
    myOnt:categoryType "Musical" ;
    myOnt:belongsToAward myOnt:TonyAwards .

myOnt:BestActorInAMusical
    a owl:NamedIndividual , myOnt:AwardCategory , myOnt:MusicalAward , myOnt:BestActorAward ;
    skos:prefLabel "Tony Award Best Actor in a Musical"@en ;
    myOnt:categoryLabel "Tony Award Best Actor in a Musical" ;
    myOnt:categoryType "Musical" ;
    myOnt:belongsToAward myOnt:TonyAwards .

myOnt:HelenMirren
    a owl:NamedIndividual , foaf:Person ;
    foaf:name "Helen Mirren" .

myOnt:TheAudience
    a owl:NamedIndividual , schema:CreativeWork ;
    schema:name "The Audience" .

myOnt:Winning_2015_Helen_Mirren
    a owl:NamedIndividual , myOnt:AwardWinning ;
    myOnt:recordIdentifier "Winning_2015_Helen_Mirren" ;
    myOnt:winner myOnt:HelenMirren ;
    myOnt:awardedForWork myOnt:TheAudience ;
    myOnt:hasAwardCategory myOnt:BestActressInAPlay ;
    myOnt:hasGenderCategory myOnt:Feminine ;
    myOnt:awardYear 2015 ;
    myOnt:genderCategory "femenina" .
